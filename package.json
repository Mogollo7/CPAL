{
  "name": "capl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && prettier --check .",
    "tipos": "tsc --noEmit",
    "pruebas": "vitest run",
    "correos": "echo 'pendiente: vista previa de plantillas'",
    "bd:subir": "docker compose --env-file .env -f infra/compose.yml up -d --wait db",
    "bd:migrar": "prisma migrate deploy",
    "bd:semilla": "prisma db seed",
    "bd:reiniciar": "prisma migrate reset --force",
    "pruebas:e2e": "echo 'pendiente: playwright'",
    "postinstall": "prisma generate",
    "tunel": "docker compose --env-file .env -f infra/compose.yml --profile tunel up -d tunel",
    "tunel:parar": "docker compose --env-file .env -f infra/compose.yml --profile tunel stop tunel",
    "tunel:logs": "docker logs --tail 30 capl-tunel"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
