{
  "name": "capl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && prettier --check .",
    "tipos": "tsc --noEmit",
    "pruebas": "vitest run --no-file-parallelism",
    "correos": "tsx correos/vista-previa.ts",
    "bd:subir": "docker compose --env-file .env -f infra/compose.yml up -d --wait db",
    "bd:migrar": "prisma migrate deploy",
    "bd:semilla": "prisma db seed",
    "bd:semilla:produccion": "tsx prisma/semilla-produccion.ts",
    "psicologos:cargar": "tsx scripts/cargar-psicologos.ts",
    "bd:reiniciar": "prisma migrate reset --force",
    "pruebas:e2e": "echo 'pendiente: playwright'",
    "postinstall": "prisma generate",
    "tunel": "docker compose --env-file .env -f infra/compose.yml --profile tunel up -d tunel",
    "tunel:parar": "docker compose --env-file .env -f infra/compose.yml --profile tunel stop tunel",
    "tunel:logs": "docker logs --tail 30 capl-tunel",
    "guardar": "node scripts/guardar.mjs local",
    "subir": "node scripts/guardar.mjs subir",
    "admin:crear": "tsx scripts/admin-crear.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
