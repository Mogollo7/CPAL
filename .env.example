# Copia a .env y rellena. NUNCA subas .env al repositorio. Ver cerebro/especificacion/E01-Stack-y-Entorno.md
DATABASE_URL=postgresql://capl_app:app_local@localhost:5433/capl
DATABASE_URL_MIGRADOR=postgresql://capl_migrador:migrador_local@localhost:5433/capl
AUTH_SECRET=
URL_SITIO=http://localhost:3000
# Llaves de Resend por prioridad, separadas por coma. Cuenta 1 = principal, cuenta 2 = respaldo (100 correos/día cada una).
# Para añadir otra cuenta: agrega su llave al final y reinicia. Rotación automática si una agota la cuota.
RESEND_API_KEYS=
CORREO_REMITENTE=
CORREO_RESPUESTA=
CORREO_REDIRIGIR_A=
# SUPUESTO(CAPL): dirección y teléfono del pie de los correos (por confirmar con el CAPL)
CAPL_DIRECCION=
CAPL_TELEFONO=
# consola (local, no envía) | resend (pruebas y producción)
CORREO_MODO=consola
# Opcional en local y modo consola. Mantén el buzón fuera de public/ y de RUTA_ARCHIVOS.
CORREO_BUZON_LOCAL=./datos/buzon
CRON_SECRET=
RUTA_ARCHIVOS=./datos/archivos
ADMIN_INICIAL_CORREO=
# Correo de un administrador existente. En local, si queda vacío, se usa el administrador inicial.
SUPERUSUARIO_CORREO=
# local | pruebas | produccion
ENTORNO=local
CLAVE_CIFRADO=
RESEND_WEBHOOK_SECRET=
GMAIL_USUARIO=
GMAIL_CLAVE_APP=
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENCIALES=
MEDICION=no

# Túnel de Cloudflare (opcional, npm run tunel). Cada persona usa su propio token; NUNCA se sube a git.
CLOUDFLARE_TUNNEL_TOKEN=

# Respaldos (infra/respaldo.sh). Ver infra/README.md. Sin valores aquí.
# SUPUESTO(P-21): destino externo por rsync sobre SSH (usuario@servidor:/ruta). Cambiar si el CAPL define otro.
RESPALDO_DESTINO_EXTERNO=
RESPALDO_CLAVE_ARCHIVO=
# Dirección interna de la app para la tarea programada (infra/tareas.sh)
APP_URL_INTERNA=http://127.0.0.1:3000

# Solo en el servidor (infra/.env, junto a infra/compose.produccion.yml). Allí DATABASE_URL y DATABASE_URL_MIGRADOR
# apuntan a `db:5432` en vez de `localhost:5433`.
DOMINIO=
POSTGRES_PASSWORD=
# Solo para inicializar un volumen de pruebas o producción. Deben coincidir con las claves de las dos URL de PostgreSQL.
CAPL_APP_PASSWORD=
CAPL_MIGRADOR_PASSWORD=
