# Copia a .env y rellena. NUNCA subas .env al repositorio. Ver cerebro/especificacion/E01-Stack-y-Entorno.md
DATABASE_URL=postgresql://capl:capl_local@localhost:5433/capl
AUTH_SECRET=
URL_SITIO=http://localhost:3000
# Llaves de Resend por prioridad, separadas por coma. Cuenta 1 = principal, cuenta 2 = respaldo (100 correos/día cada una).
# Para añadir otra cuenta: agrega su llave al final y reinicia. Rotación automática si una agota la cuota.
RESEND_API_KEYS=
CORREO_REMITENTE=
CORREO_RESPUESTA=
CORREO_REDIRIGIR_A=
# consola (local, no envía) | resend (pruebas y producción)
CORREO_MODO=consola
CRON_SECRET=
RUTA_ARCHIVOS=./datos/archivos
ADMIN_INICIAL_CORREO=
# local | pruebas | produccion
ENTORNO=local
CLAVE_CIFRADO=
RESEND_WEBHOOK_SECRET=
GMAIL_USUARIO=
GMAIL_CLAVE_APP=
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENCIALES=
MEDICION=no

# Túnel de Cloudflare (opcional, npm run tunel). Cada persona usa su propio token; NUNCA se sube a git.
CLOUDFLARE_TUNNEL_TOKEN=
